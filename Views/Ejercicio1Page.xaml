<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ActividadMauiApp.Views.Ejercicio1Page"
             Title="1. Suma de Dos Números"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Card Header -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#4F46E5" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Ejercicio 1: Suma de Dos Números" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Aplica variables, conversión de tipos de datos, operadores aritméticos y eventos." FontSize="12" TextColor="#E0E7FF" />
                </VerticalStackLayout>
            </Border>

            <!-- Form Card -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="20">
                <VerticalStackLayout Spacing="16">

                    <!-- Numero 1 -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Primer Número:" FontAttributes="Bold" TextColor="#334155" FontSize="14" />
                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC">
                            <Entry x:Name="txtNumero1"
                                   Placeholder="Ej: 15"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   Margin="10,0"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Numero 2 -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Segundo Número:" FontAttributes="Bold" TextColor="#334155" FontSize="14" />
                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC">
                            <Entry x:Name="txtNumero2"
                                   Placeholder="Ej: 27"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   Margin="10,0"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="➕ Sumar"
                                Clicked="OnSumarClicked"
                                BackgroundColor="#4F46E5"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="48" />

                        <Button Grid.Column="1"
                                Text="🗑️ Limpiar"
                                Clicked="OnLimpiarClicked"
                                BackgroundColor="#EF4444"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="48" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Result Card -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="20">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="Resultado de la Operación" FontSize="14" TextColor="#64748B" HorizontalTextAlignment="Center" />
                    <Label x:Name="lblResultado"
                           Text="--"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#10B981"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
