<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ActividadMauiApp.Views.Ejercicio3Page"
             Title="3. CheckBox"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Card Header -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#4F46E5" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Ejercicio 3: Control CheckBox" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Uso de casillas de verificación independientes y control de eventos multiplataforma." FontSize="12" TextColor="#E0E7FF" />
                </VerticalStackLayout>
            </Border>

            <!-- Card Items Selector -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="20">
                <VerticalStackLayout Spacing="16">

                    <!-- Precio Base Entry -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Monto o Subtotal Base ($):" FontAttributes="Bold" TextColor="#334155" FontSize="14" />
                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC">
                            <Entry x:Name="txtMontoBase"
                                   Placeholder="Ej: 100"
                                   Text="100"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   Margin="10,0"
                                   TextChanged="OnMontoBaseTextChanged"/>
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="Servicios y Opciones Adicionales:" FontAttributes="Bold" TextColor="#334155" FontSize="14" Margin="0,6,0,0"/>

                    <!-- CheckBox Item 1 -->
                    <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" Padding="12">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <CheckBox x:Name="chkGarantia"
                                      Color="#4F46E5"
                                      CheckedChanged="OnOpcionCheckedChanged" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Garantía Extendida (+ $25.00)" FontAttributes="Bold" TextColor="#1E293B" FontSize="14"/>
                                <Label Text="Cubre fallas de hardware y soporte por 2 años." FontSize="11" TextColor="#64748B"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- CheckBox Item 2 -->
                    <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" Padding="12">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <CheckBox x:Name="chkEnvioExpress"
                                      Color="#4F46E5"
                                      CheckedChanged="OnOpcionCheckedChanged" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Envío Express Prioritario (+ $15.00)" FontAttributes="Bold" TextColor="#1E293B" FontSize="14"/>
                                <Label Text="Entrega garantizada en menos de 24 horas." FontSize="11" TextColor="#64748B"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- CheckBox Item 3 -->
                    <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" Padding="12">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <CheckBox x:Name="chkDescuento"
                                      Color="#10B981"
                                      CheckedChanged="OnOpcionCheckedChanged" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Cupón de Descuento (-10% al Subtotal)" FontAttributes="Bold" TextColor="#10B981" FontSize="14"/>
                                <Label Text="Descuento promocional para estudiantes y miembros." FontSize="11" TextColor="#64748B"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Reset Button -->
                    <Button Text="🔄 Restablecer Opciones"
                            Clicked="OnRestablecerClicked"
                            BackgroundColor="#64748B"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="44"
                            Margin="0,8,0,0"/>

                </VerticalStackLayout>
            </Border>

            <!-- Summary Card -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Resumen de la Selección" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" />
                    
                    <Label x:Name="lblDetalle" Text="Ningún adicional seleccionado." FontSize="13" TextColor="#64748B" />
                    
                    <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,4" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Total Calculado:" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                        <Label x:Name="lblTotal" Grid.Column="1" Text="$100.00" FontSize="22" FontAttributes="Bold" TextColor="#10B981" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
